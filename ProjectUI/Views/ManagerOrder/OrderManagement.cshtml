@{
    ViewData["Title"] = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mt-4">
    <h2>Quản lý đơn hàng</h2>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Khách hàng</th>
                <th>Ngày đặt</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody id="orderTableBody">
            <!-- Dữ liệu sẽ được load bằng JS -->
        </tbody>
    </table>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
    function getStatusText(status) {
        if (status === "Chờ xác nhận" || status === "PendingConfirmation") return "Chờ xác nhận";
        if (status === "Đang vận chuyển" || status === "Shipping") return "Đang vận chuyển";
        if (status === "Chờ xác nhận thanh toán") return "Chờ xác nhận thanh toán";
        return status || "Không xác định";
    }

    function loadOrders() {
        axios.get('https://localhost:7227/api/Orders?orderBy=createdAtDesc')
            .then(res => {
                const orders = res.data;
                let html = '';
                orders.forEach(order => {
                    const orderDate = order.createdAt ? new Date(order.createdAt).toLocaleDateString('vi-VN') : '';

                    html += `<tr>
                            <td>${order.orderId}</td>
                            <td>${order.customerName || ''}</td>
                            <td>${orderDate}</td>
                            <td><span class="badge bg-${order.status === 'Chờ xác nhận' || order.status === 'PendingConfirmation' ? 'warning' : order.status === 'Đang vận chuyển' || order.status === 'Shipping' ? 'info' : order.status === 'Chờ xác nhận thanh toán' ? 'secondary' : 'secondary'}">${getStatusText(order.status)}</span></td>
                            <td>
                                <button class='btn btn-success btn-sm me-1' data-order-id="${order.orderId}" onclick='confirmOrder(${order.orderId})' ${order.status === 'Đang vận chuyển' || order.status.startsWith('Đã hủy') ? 'disabled' : ''}>Xác nhận</button>
                                <button class='btn btn-danger btn-sm' data-order-id="${order.orderId}" onclick='rejectOrder(${order.orderId})' ${order.status === 'Đang vận chuyển' || order.status.startsWith('Đã hủy') ? 'disabled' : ''}>Từ chối</button>
                            </td>
                        </tr>`;
                });
                document.getElementById('orderTableBody').innerHTML = html;
            })
            .catch(error => {
                console.error('Error loading orders:', error);
                document.getElementById('orderTableBody').innerHTML = `<tr><td colspan="5" class="text-center text-danger">Không thể tải danh sách đơn hàng</td></tr>`;
            });
    }

    async function confirmOrder(orderId) {
        const result = await Swal.fire({
            title: 'Xác nhận đơn hàng',
            text: 'Bạn chắc chắn xác nhận đơn hàng này?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Xác nhận',
            cancelButtonText: 'Hủy'
        });

        if (result.isConfirmed) {
            axios.put(`https://localhost:7227/api/Orders/${orderId}/confirm`)
                .then(() => {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        text: 'Đã xác nhận và gửi email cho khách!',
                        timer: 2000,
                        showConfirmButton: false
                    });
                    // Cập nhật trạng thái nút trên UI
                    const confirmButton = document.querySelector(`button[data-order-id="${orderId}"].btn-success`);
                    const rejectButton = document.querySelector(`button[data-order-id="${orderId}"].btn-danger`);

                    if (confirmButton) {
                        confirmButton.textContent = 'Đã xác nhận';
                        confirmButton.disabled = true;
                        confirmButton.classList.remove('btn-success');
                        confirmButton.classList.add('btn-secondary');
                    }
                    if (rejectButton) {
                        rejectButton.disabled = true;
                        rejectButton.classList.remove('btn-danger');
                        rejectButton.classList.add('btn-secondary');
                    }
                    const statusSpan = confirmButton.closest('tr').querySelector('td:nth-child(4) span.badge');
                    if (statusSpan) {
                        statusSpan.textContent = 'Đang vận chuyển';
                        statusSpan.classList.remove('bg-warning', 'bg-secondary', 'bg-danger');
                        statusSpan.classList.add('bg-info');
                    }
                })
                .catch(() => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi!',
                        text: 'Lỗi xác nhận đơn hàng!',
                        confirmButtonText: 'Đóng'
                    });
                });
        }
    }

    async function rejectOrder(orderId) {
        const result = await Swal.fire({
            title: 'Từ chối đơn hàng',
            text: 'Bạn chắc chắn từ chối đơn hàng này?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Từ chối',
            cancelButtonText: 'Hủy',
            dangerMode: true
        });

        if (result.isConfirmed) {
            axios.put(`https://localhost:7227/api/Orders/${orderId}/reject`)
                .then(() => {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        text: 'Đã từ chối đơn hàng!',
                        timer: 2000,
                        showConfirmButton: false
                    });
                    // Cập nhật trạng thái nút trên UI
                    const confirmButton = document.querySelector(`button[data-order-id="${orderId}"].btn-success`);
                    const rejectButton = document.querySelector(`button[data-order-id="${orderId}"].btn-danger`);

                    if (rejectButton) {
                        rejectButton.textContent = 'Đã từ chối';
                        rejectButton.disabled = true;
                        rejectButton.classList.remove('btn-danger');
                        rejectButton.classList.add('btn-secondary');
                    }
                    if (confirmButton) {
                        confirmButton.disabled = true;
                        confirmButton.classList.remove('btn-success');
                        confirmButton.classList.add('btn-secondary');
                    }
                    const statusSpan = rejectButton.closest('tr').querySelector('td:nth-child(4) span.badge');
                    if (statusSpan) {
                        statusSpan.textContent = 'Đã hủy';
                        statusSpan.classList.remove('bg-warning', 'bg-info', 'bg-secondary');
                        statusSpan.classList.add('bg-danger');
                    }
                })
                .catch(() => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi!',
                        text: 'Lỗi từ chối đơn hàng!',
                        confirmButtonText: 'Đóng'
                    });
                });
        }
    }

    // Load khi vào trang
    loadOrders();
</script> 