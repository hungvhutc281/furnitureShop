@{
    ViewData["Title"] = "Quản lý danh mục";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h1>Quản lý loại sản phẩm</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item active">Mục sản phẩm</li>
            </ol>
        </nav>
    </div>

    <section class="section">
        <div class="row">
            <div class="col-lg-12">

                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Danh sách mục</h5>

                       
                        <div class="mb-3">
                            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#categoryModal">
                                <i class="bi bi-plus-circle"></i> Thêm mục mới
                            </button>
                            <input id="searchBox" type="text" class="form-control mt-3" placeholder="Tìm kiếm theo tên..." />
                        </div>

                        <table class="table table-striped" id="categoryTable">
                            <thead>
                                <tr>
                                    <th>Số thứ tự </th>
                                    <th>Tên loại</th>
                                    <th>Mô tả</th>
                                    <th>Chức năng</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>

                    </div>
                </div>

            </div>
        </div>
    </section>
</main>

<div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form id="categoryForm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="categoryModalLabel">Tạo / Sửa </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="categoryId" />
                    <div class="mb-3">
                        <label for="categoryName" class="form-label">Tên</label>
                        <input type="text" class="form-control" id="categoryName" required />
                    </div>
                    <div class="mb-3">
                        <label for="categoryDescription" class="form-label">Mô tả</label>
                        <textarea class="form-control" id="categoryDescription" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Lưu</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
        const apiUrl = "https://localhost:7227/api/admin/category";

        // load toàn bộ danh mục
        function loadCategories() {
            axios.get(apiUrl).then(res => {
                const rows = res.data.map(c => `
                            <tr>
                                <td>${c.categoryId}</td>
                                <td>${c.categoryName}</td>
                                <td>${c.description ?? ''}</td>
                                <td>
                                    <button class="btn btn-warning btn-sm" onclick="editCategory(${c.categoryId})">Sửa</button>
                                    <button class="btn btn-danger btn-sm" onclick="deleteCategory(${c.categoryId})">Xóa</button>
                                </td>
                            </tr>
                        `).join("");
                document.querySelector("#categoryTable tbody").innerHTML = rows;
            });
        }

        // thêm sửa
        document.getElementById("categoryForm").addEventListener("submit", function (e) {
            e.preventDefault();
            const id = document.getElementById("categoryId").value;
            const data = {
                categoryName: document.getElementById("categoryName").value,
                description: document.getElementById("categoryDescription").value
            };

            if (id) {
                axios.put(`${apiUrl}/${id}`, data).then(() => {
                    loadCategories();
                    bootstrap.Modal.getInstance(document.getElementById("categoryModal")).hide();
                });
            } else {
                axios.post(apiUrl, data).then(() => {
                    loadCategories();
                    bootstrap.Modal.getInstance(document.getElementById("categoryModal")).hide();
                });
            }
        });

        // kiểm tra dữ liệu sửa
        function editCategory(id) {
            axios.get(`${apiUrl}/${id}`).then(res => {
                document.getElementById("categoryId").value = res.data.categoryId;
                document.getElementById("categoryName").value = res.data.categoryName;
                document.getElementById("categoryDescription").value = res.data.description;
                new bootstrap.Modal(document.getElementById("categoryModal")).show();
            });
        }

        //kiểm tra xóa
        function deleteCategory(id) {
            if (confirm("Bạn có chắc chán xóa mục này ?")) {
                axios.delete(`${apiUrl}/${id}`).then(() => loadCategories());
            }
        }

        // lọc tìm kiếm
        document.getElementById("searchBox").addEventListener("input", function () {
            const keyword = this.value.toLowerCase();
            document.querySelectorAll("#categoryTable tbody tr").forEach(row => {
                const name = row.children[1].textContent.toLowerCase();
                row.style.display = name.includes(keyword) ? "" : "none";
            });
        });

        loadCategories();
    </script>
}
