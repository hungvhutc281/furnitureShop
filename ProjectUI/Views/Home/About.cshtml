@{
    ViewData["Title"] = "Giới thiệu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Hiệu ứng cho card hình ảnh */
    .production-card {
        transition: all 0.5s ease;
        border: none;
        overflow: hidden;
        position: relative;
    }

        .production-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.2) !important;
        }

        .production-card img {
            transition: all 0.5s ease;
        }

        .production-card:hover img {
            transform: scale(1.05);
        }

        .production-card::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: linear-gradient(90deg, #FFA500, #e67e22);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s ease;
        }

        .production-card:hover::after {
            transform: scaleX(1);
        }

    /* Hiệu ứng cho tiêu đề */
    .section-title {
        position: relative;
        display: inline-block;
    }

        .section-title::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 3px;
            bottom: -5px;
            left: 0;
            background: linear-gradient(90deg, #FFA500, #e67e22);
            transform: scaleX(0);
            transform-origin: right;
            transition: transform 0.3s ease;
        }

        .section-title:hover::after {
            transform: scaleX(1);
            transform-origin: left;
        }

    /* Hiệu ứng cho founder quote */
    .founder-quote {
        transition: all 0.3s ease;
    }

        .founder-quote:hover {
            background-color: rgba(255, 165, 0, 0.05);
            border-left-color: #e67e22 !important;
        }

    /* Hiệu ứng cho các giá trị cốt lõi */
    .core-value li {
        transition: all 0.3s ease;
        position: relative;
        padding-left: 15px;
    }

        .core-value li::before {
            content: '→';
            position: absolute;
            left: -5px;
            color: #FFA500;
            opacity: 0;
            transition: all 0.3s ease;
        }

        .core-value li:hover {
            padding-left: 20px;
            color: #e67e22;
        }

            .core-value li:hover::before {
                opacity: 1;
                left: 0;
            }

    /* Hiệu ứng cho badge founder */
    .founder-badge {
        transition: all 0.3s ease;
        transform: perspective(100px) rotateX(0deg);
    }

        .founder-badge:hover {
            transform: perspective(100px) rotateX(20deg);
            box-shadow: 0 5px 15px rgba(255, 165, 0, 0.3);
        }

    /* Section header cho quy trình */
    .process-section-header {
        background: linear-gradient(135deg, #FFA500, #e67e22);
        color: white;
        padding: 15px 25px;
        border-radius: 10px;
        margin-bottom: 30px;
        text-align: center;
    }

    /* Styles cho phần bản đồ */
    .map-container {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        transition: all 0.3s ease;
    }

        .map-container:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 35px rgba(0,0,0,0.2);
        }

    .contact-info-card {
        background: linear-gradient(135deg, rgba(255, 165, 0, 0.05), rgba(230, 126, 34, 0.05));
        border: 1px solid rgba(255, 165, 0, 0.2);
        border-radius: 15px;
        padding: 30px;
        transition: all 0.3s ease;
        height: 100%;
    }

        .contact-info-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(255, 165, 0, 0.15);
            border-color: rgba(230, 126, 34, 0.3);
        }

    .contact-item {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
        padding: 15px;
        background: rgba(255, 255, 255, 0.7);
        border-radius: 10px;
        transition: all 0.3s ease;
    }

        .contact-item:hover {
            background: rgba(255, 165, 0, 0.1);
            transform: translateX(10px);
        }

    .contact-icon {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #FFA500, #e67e22);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
        color: white;
        font-size: 1.2rem;
        transition: all 0.3s ease;
    }

    .contact-item:hover .contact-icon {
        transform: rotate(360deg);
    }

    .location-section {
        background: linear-gradient(135deg, rgba(255, 165, 0, 0.02), rgba(230, 126, 34, 0.02));
        padding: 50px 0;
        margin: 50px 0;
        border-radius: 20px;
    }


    /* CSS cho logo tròn với hiệu ứng hover */
    .logo-hover {
        transition: all 0.5s ease;
        cursor: pointer;
    }

        .logo-hover:hover {
            transform: scale(1.05) rotate(5deg);
            box-shadow: 0 15px 35px rgba(255, 165, 0, 0.4) !important;
            border-color: #e67e22 !important;
        }

    /* Responsive cho logo */
    @@media (max-width: 768px) {
        .logo-hover {
            width: 250px !important;
            height: 250px !important;
        }
    }

    @@media (max-width: 576px) {
        .logo-hover {
            width: 200px !important;
            height: 200px !important;
        }
    }

</style>

<section class="about-section py-5">
    <div class="container">
        <!-- Banner giới thiệu -->




        <!-- Section Founder -->
        <div class="row align-items-center mb-5">
            <div class="col-md-4 mb-4 mb-md-0 text-center">
                <img src="@Url.Content("~/images/FounderH&Hluxury.jpg")" alt="Mr Hoàng Hùng - Người sáng lập H&H Luxury" class="img-fluid rounded-circle shadow" style="width:220px;height:220px;object-fit:cover;display:block;margin:auto; transition: all 0.3s ease;">
                <div class="mt-3"><span class="badge bg-warning text-dark founder-badge" style="font-size:1.1rem;">Founder</span></div>
            </div>
            <div class="col-md-8">
                <h3 class="mb-2 section-title" style="font-weight:bold;">Người sáng lập - <span style="color:#e53935;">Mr Hoàng Hùng</span></h3>
                <p style="font-size:1.08rem; transition: all 0.3s ease;" class="hover-text">Với hơn 7 năm kinh nghiệm trong lĩnh vực nội thất, <b>Mr Hoàng Hùng</b> đã xây dựng nên thương hiệu H&H Luxury với khát vọng mang đến cho người Việt những sản phẩm nội thất chất lượng quốc tế, dịch vụ tận tâm và trải nghiệm mua sắm hiện đại. Anh là người truyền cảm hứng, dẫn dắt đội ngũ H&H Luxury không ngừng đổi mới, sáng tạo để phục vụ khách hàng tốt nhất.</p>
                <blockquote class="blockquote mt-3 mb-0 ps-3 border-start border-3 border-warning founder-quote">
                    <p class="mb-1" style="font-size:1.1rem;">"Nội thất không chỉ là vật dụng, mà còn là nghệ thuật nâng tầm giá trị sống cho mỗi gia đình."</p>
                    <footer class="blockquote-footer">Mr Hoàng Hùng, Founder H&H Luxury</footer>
                </blockquote>
            </div>
        </div>

        <div class="row align-items-center mb-5">
            <div class="col-md-4 mb-4 mb-md-0 text-center">
                <img src="@Url.Content("~/images/LogoHH.png")"
                     alt="Nội thất H&H Luxury"
                     class="img-fluid rounded-circle shadow logo-hover"
                     style="object-fit:cover; width:270px; height:270px; border: 4px solid #FFA500; transition: all 0.3s ease;">
            </div>
            
            <div class="col-md-5">
                <h2 class="mb-3 section-title" style="color:#FFA500; font-weight:bold;">H&H Luxury – Tiên phong nội thất cao cấp</h2>
                <p style="font-size:1.1rem; transition: all 0.3s ease;" class="hover-text">H&H Luxury là thương hiệu nội thất cao cấp, thành lập từ năm 2018 bởi Founder Hoàng Hùng. Chúng tôi tự hào mang đến giải pháp tổng thể từ thiết kế, thi công đến cung cấp sản phẩm nội thất hiện đại, sang trọng cho biệt thự, căn hộ, penthouse, villa...</p>
            </div>
        </div>


        <!-- Section Quy trình sản xuất và giao hàng -->
        <div class="mb-5">
            <div class="process-section-header">
                <h4 class="mb-0" style="font-weight:bold;">Quy trình sản xuất và giao hàng tại H&H Luxury</h4>
                <p class="mb-0 mt-2">Từ xưởng sản xuất hiện đại đến tay khách hàng</p>
            </div>

            <!-- Phần 1: Xưởng sản xuất -->
