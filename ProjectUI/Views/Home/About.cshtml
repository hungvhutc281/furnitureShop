                    {
                    "AnhSanXuatDoNoiThat10.jpg",
                    "AnhSanXuatDoNoiThat2.jpg.webp",
                    "AnhSanXuatDoNoiThat3.jpg",
                    "AnhSanXuatDoNoiThat4.jpg.webp",
                    "AnhSanXuatDoNoiThat6.jpg.webp",
                    "AnhSanXuatDoNoiThat7.jpg",
                    "AnhSanXuatDoNoiThat8.jpg",
                    "AnhSanXuatDoNoiThat9.webp"
                    };

                        var deliveryDescriptions = new List<string>
                    {
                    "Kiểm tra chất lượng sản phẩm trước khi đóng gói",
                    "Đóng gói cẩn thận, bảo vệ sản phẩm trong quá trình vận chuyển",
                    "Vận chuyển chuyên nghiệp với đội ngũ giao hàng tận tâm",
                    "Lắp đặt tại nhà khách hàng bởi đội ngũ kỹ thuật viên",
                    "Hướng dẫn sử dụng và bảo trì sản phẩm chi tiết",
                    "Kiểm tra lần cuối cùng sau khi lắp đặt hoàn thành",
                    "Bàn giao sản phẩm hoàn thiện đến khách hàng",
                    "Dịch vụ hậu mãi và bảo hành chu đáo"
                    };
                    }

                    @for (int i = 0; i < deliveryImages.Count; i++)
                    {
                        <div class="col-md-3 col-sm-6 col-12">
                            <div class="card h-100 shadow-sm production-card">
                                <img src="@($"/images/{deliveryImages[i]}")" alt="Giao hàng @(i+1)" class="card-img-top" style="height:200px;object-fit:cover;" />
                                <div class="card-body text-center">
                                    <div class="mb-2" style="font-weight:bold; color:#e67e22; transition: all 0.3s ease;" class="hover-text">Sản phẩm tới tay khách hàng</div>
