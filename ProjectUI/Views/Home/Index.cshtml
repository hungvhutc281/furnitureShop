@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            let allProducts = [];
            let currentPage = 1;
            const pageSize = 10;

            function renderProducts(products) {
                let html = '';
                let wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');
                products.forEach(function (product) {
                    const isWishlisted = wishlist.includes(product.productId.toString());
                    // Xác định nguồn hình ảnh: sử dụng base64 trực tiếp hoặc thêm URL cơ sở vào trước
                    const imgSrc = product.image && product.image.startsWith('data:') ? product.image : `https://localhost:7227${product.image}`;

                    html += `
                                                                <div class="col mb-4">
                                                                    <div class="product-item hover-effect-slide h-100 position-relative">
                                                                        <a href="/Product/Details/${product.productId}" style="text-decoration:none;color:inherit;">
                                                                            <div class="image-holder position-relative" style="aspect-ratio:336/472;overflow:hidden;">
                                                                                <img src="${imgSrc}" alt="${product.productName}" class="product-image img-fluid" style="object-fit:cover;width:100%;height:100%;">
                                                                            </div>
                                                                            <div class="product-content">
                                                                                <h5 class="element-title text-uppercase fs-5 mt-3">
                                                                                    ${product.productName}
                                                                                </h5>
                                                                                <span class="fw-bold text-danger">${product.price.toLocaleString()} VNĐ</span>
                                                                            </div>
                                                                        </a>
                                                                        <button class="wishlist-btn position-absolute top-0 end-0 m-2 bg-white border-0 rounded-circle p-2" data-product-id="${product.productId}" title="Lưu sản phẩm">
                                                                            <svg width="24" height="24" viewBox="0 0 24 24">
                                                                                <use xlink:href="#heart" ${isWishlisted ? 'style=\"fill:#FFA500\"' : ''}></use>
                                                                            </svg>
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                            `;
                });
                $('#product-list').html(html);
            }

            function renderPagination(totalPages) {
                let html = '';
                if (totalPages > 1) {
                    html += '<nav class="d-flex justify-content-center"><ul class="pagination">';
                    //Nút trước
                    html += `<li class="page-item${currentPage === 1 ? ' disabled' : ''}"><a class="page-link" href="javascript:void(0)" data-page="${currentPage - 1}" aria-label="Previous"><span aria-hidden="true">&laquo;</span></a></li>`;
                    // Page numbers
                    for (let i = 1; i <= totalPages; i++) {
                        html += `<li class="page-item${i === currentPage ? ' active' : ''}"><a class="page-link" href="javascript:void(0)" data-page="${i}">${i}</a></li>`;
                    }
                    // Next button
                    html += `<li class="page-item${currentPage === totalPages ? ' disabled' : ''}"><a class="page-link" href="javascript:void(0)" data-page="${currentPage + 1}" aria-label="Next"><span aria-hidden="true">&raquo;</span></a></li>`;
                    html += '</ul></nav>';
                }
                $('#product-pagination').html(html);
            }

            function showPage(page) {
                currentPage = page;
                const start = (page - 1) * pageSize;
                const end = start + pageSize;
                renderProducts(allProducts.slice(start, end));
                renderPagination(Math.ceil(allProducts.length / pageSize));
            }

            // Load tất cả sản phẩm
            $.ajax({
                url: 'https://localhost:7227/api/admin/product',
                method: 'GET',
                success: function (data) {
                    allProducts = data;
                    showPage(1);
                },
                error: function () {
                    $('#product-list').html('<p class="text-danger">Không thể tải sản phẩm!</p>');
                }
            });

            // Sự kiện click phân trang
            $(document).on('click', '.pagination .page-link', function (e) {
                e.preventDefault();
                const page = parseInt($(this).data('page'));
                if (!isNaN(page)) {
                    showPage(page);
                }
                return false;
            });

            // Thêm script xử lý wishlist
            $(document).on('click', '.wishlist-btn', function (e) {
                e.preventDefault();
                var btn = $(this);
                var productId = btn.data('product-id').toString();
                var wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');
                var svgUse = btn.find('svg use');
                if (wishlist.includes(productId)) {
                    wishlist = wishlist.filter(id => id !== productId);
                    svgUse.removeAttr('style');
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: 'Bỏ lưu sản phẩm!',
                        showConfirmButton: false,
                        timer: 2000,
                        timerProgressBar: true,
                        background: '#fff0f0',
                        color: '#d32f2f',
                        customClass: { popup: 'swal2-toast-custom' }
                    });
                } else {
                    wishlist.push(productId);
                    svgUse.attr('style', 'fill:#FFA500');
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: 'Lưu thành công sản phẩm! Để xem chi tiết vui lòng vào phần lưu.',
                        showConfirmButton: false,
                        timer: 2000,
                        timerProgressBar: true,
                        background: '#e6fff2',
                        color: '#1a7f37',
                        customClass: { popup: 'swal2-toast-custom' }
                    });
                }
                localStorage.setItem('wishlist', JSON.stringify(wishlist));
                updateWishlistCount();
            });

            // Hàm cập nhật số lượng wishlist trên navbar
            function updateWishlistCount() {
                var wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');
                $('#wishlist-count').text(wishlist.length);
            }

            // Khi load trang, cập nhật số lượng wishlist
            updateWishlistCount();
        });

        // Kiểm tra user còn tồn tại
        async function checkUserStillExists() {
            const userId = localStorage.getItem("userId");
            if (!userId) return;

            try {
                const response = await fetch(`https://localhost:7227/api/admin/user/${userId}`);
                if (!response.ok) {
                    const modal = new bootstrap.Modal(document.getElementById("accountDeletedModal"));
                    modal.show();

                    setTimeout(() => {
                        localStorage.clear();
                        sessionStorage.clear();
                        window.location.href = "/Users/Login";
                    }, 3000);
                }
            } catch (error) {
                console.error("Không thể kiểm tra tài khoản:", error);
            }
        }

        document.addEventListener("DOMContentLoaded", checkUserStillExists);
        document.addEventListener("visibilitychange", function () {
            if (document.visibilityState === "visible") {
                checkUserStillExists();
            }
        });
        window.addEventListener("pageshow", function (event) {
            if (event.persisted || performance.getEntriesByType("navigation")[0].type === "back_forward") {
                checkUserStillExists();
            }
        });

        // LOAD SẢN PHẨM BÁN CHẠY NHẤT - UPDATED VERSION
        document.addEventListener("DOMContentLoaded", function () {
            // Hiển thị loading
            document.getElementById("best-seller-list").innerHTML = '<div class="col-12 text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>';

            fetch('https://localhost:7227/api/admin/product/best-seller')
                .then(response => response.json())
                .then(products => {
                    const container = document.getElementById("best-seller-list");
                    container.innerHTML = "";

                    // Lấy wishlist từ localStorage
                    let wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');

                    products.forEach(product => {
                        const isWishlisted = wishlist.includes(product.productId.toString());
                        const imgSrc = product.image && product.image.startsWith('data:') ? product.image : `https://localhost:7227${product.image}`;


                        const productHtml = `
                                                                    <div class="col mb-4">
                                                                        <div class="product-item hover-effect-slide h-100 position-relative">
                                                                            <a href="/Product/Details/${product.productId}" style="text-decoration:none;color:inherit;">
                                                                                <div class="image-holder position-relative" style="aspect-ratio:336/472;overflow:hidden;border-radius:8px;">
                                                                                    <img src="${imgSrc}" alt="${product.productName}" class="product-image img-fluid" style="object-fit:cover;width:100%;height:100%;transition:transform 0.3s ease;">
                                                                                </div>
                                                                                <div class="product-content" style="padding:15px;">
                                                                                    <h5 class="element-title text-uppercase fs-5 mt-3" style="margin-bottom:8px;font-weight:600;color:#333;transition:color 0.3s ease;">
                                                                                        ${product.productName}
                                                                                    </h5>
                                                                                    <span class="fw-bold text-danger">${product.price.toLocaleString()} VNĐ</span>
                                                                                </div>
                                                                            </a>
                                                                            <button class="wishlist-btn position-absolute top-0 end-0 m-2 bg-white border-0 rounded-circle p-2 shadow-sm"
                                                                                    data-product-id="${product.productId}"
                                                                                    title="Lưu sản phẩm"
                                                                                    style="transition:all 0.3s ease;opacity:0.8;z-index:10;">
                                                                                <svg width="24" height="24" viewBox="0 0 24 24">
                                                                                    <use xlink:href="#heart" ${isWishlisted ? 'style="fill:#FFA500"' : ''}></use>
                                                                                </svg>
                                                                            </button>
                                                                        </div>
                                                                    </div>`;

                        container.insertAdjacentHTML("beforeend", productHtml);
                    });

                    // Thêm hiệu ứng hover sau khi render
                    addBestSellerHoverEffects();

                })
                .catch(error => {
                    console.error("Lỗi khi tải sản phẩm bán chạy:", error);
                    document.getElementById("best-seller-list").innerHTML = '<div class="col-12"><p class="text-danger text-center">Không thể tải sản phẩm bán chạy!</p></div>';
                });
        });

        // Hàm thêm hiệu ứng hover cho sản phẩm bán chạy
        function addBestSellerHoverEffects() {
            // Hover effect cho toàn bộ product item
            document.querySelectorAll('#best-seller-list .product-item').forEach(item => {
                item.style.transition = 'all 0.3s ease';
                item.style.borderRadius = '8px';
                item.style.overflow = 'hidden';
                item.style.backgroundColor = 'white';

                item.addEventListener('mouseenter', function () {
                    this.style.transform = 'translateY(-5px)';
                    this.style.boxShadow = '0 10px 25px rgba(0,0,0,0.1)';

                    // Hover effect cho hình ảnh
                    const img = this.querySelector('.product-image');
                    if (img) img.style.transform = 'scale(1.05)';

                    // Hover effect cho title
                    const title = this.querySelector('.element-title');
                    if (title) title.style.color = '#FFA500';

                    // Hover effect cho wishlist button
                    const wishlistBtn = this.querySelector('.wishlist-btn');
                    if (wishlistBtn) {
                        wishlistBtn.style.opacity = '1';
                        wishlistBtn.style.transform = 'scale(1.1)';
                    }
                });

                item.addEventListener('mouseleave', function () {
                    this.style.transform = 'translateY(0)';
                    this.style.boxShadow = 'none';

                    // Reset hình ảnh
                    const img = this.querySelector('.product-image');
                    if (img) img.style.transform = 'scale(1)';

                    // Reset title
                    const title = this.querySelector('.element-title');
                    if (title) title.style.color = '#333';

                    // Reset wishlist button
                    const wishlistBtn = this.querySelector('.wishlist-btn');
                    if (wishlistBtn) {
                        wishlistBtn.style.opacity = '0.8';
                        wishlistBtn.style.transform = 'scale(1)';
                    }
                });
            });

            // Hover effect riêng cho wishlist button
            document.querySelectorAll('#best-seller-list .wishlist-btn').forEach(btn => {
                btn.addEventListener('mouseenter', function () {
                    this.style.backgroundColor = '#f8f9fa';
                });

                btn.addEventListener('mouseleave', function () {
                    this.style.backgroundColor = 'white';
                });
            });
        }

        function loadTestimonials() {
            $.ajax({
                url: 'https://localhost:7227/api/Comment',
                method: 'GET',
                success: function (comments) {
                    const testimonialContent = document.querySelector('.testimonial-content');
                    testimonialContent.innerHTML = ''; 

                    if (comments.length > 0) {
                        let allTestimonialsHtml = '';
                        comments.forEach(function (comment) {
                            const ratingStars = '★'.repeat(comment.rating) + '☆'.repeat(5 - comment.rating);
                            const commentHtml = `
                                        <div class="testimonial-item">
                                            <h5>"${comment.content}"</h5>
                                            <div class="review-title text-uppercase">${comment.userName}</div>
                                            <div class="text-warning">${ratingStars}</div>
                                        </div>
                                    `;
                            allTestimonialsHtml += commentHtml;
                        });

                        const duplicatedTestimonialsHtml = allTestimonialsHtml + allTestimonialsHtml;
                        // Đặt innerHTML có nội dung trùng lặp
                        testimonialContent.innerHTML = duplicatedTestimonialsHtml;

                    } else {
                        testimonialContent.innerHTML = '<div class="testimonial-item">Chưa có đánh giá nào.</div>';
                    }
                },
                error: function () {
                    const testimonialContent = document.querySelector('.testimonial-content');
                    testimonialContent.innerHTML = '<div class="testimonial-item text-danger">Không thể tải đánh giá.</div>';
                }
            });
        }


        function loadLatestNews() {
            $.ajax({
                url: 'https://localhost:7227/api/News/latest',
                method: 'GET',
                success: function (news) {
                    const newsContainer = $('#latest-news');
                    newsContainer.empty();

                    if (news.length === 0) {
                        newsContainer.html('<div class="col-12"><p class="text-center">Chưa có tin tức nào.</p></div>');
                        return;
                    }

                    news.forEach(function (item) {
                        const date = new Date(item.postedDate).toLocaleDateString('vi-VN', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric'
                        });

                        const imgSrc = item.image && item.image.startsWith('data:') ? item.image : `https://localhost:7227${item.image}`;

                        const newsHtml = `
                                                    <div class="col-md-4 mb-4">
                                                        <article class="post-item h-100" style="transition: transform 0.3s ease;">
                                                            <div class="post-image position-relative overflow-hidden" style="border-radius: 8px;">
                                                                <a href="/News/Details/${item.newsID}" class="d-block">
                                                                    <img src="${imgSrc}" alt="${item.title}"
                                                                         class="post-grid-image img-fluid w-100"
                                                                         style="height: 250px; object-fit: cover; transition: transform 0.3s ease;">
                                                                </a>
                                                            </div>
                                                            <div class="post-content p-3">
                                                                <div class="post-meta text-uppercase fs-6 text-secondary mb-2">
                                                                    <span class="post-author">${item.author}</span> /
                                                                    <span class="post-date">${date}</span>
                                                                </div>
                                                                <h2 class="post-title h5 mb-3">
                                                                    <a href="/News/Details/${item.newsID}" class="text-dark text-decoration-none">
                                                                        ${item.title}
                                                                    </a>
                                                                </h2>
                                                                <p class="text-muted mb-3" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                                                    ${item.content}
                                                                </p>
                                                                <a href="/News/Details/${item.newsID}" class="btn btn-outline-primary rounded-pill px-4">
                                                                    Đọc thêm
                                                                </a>
                                                            </div>
                                                        </article>
                                                    </div>
                                                `;
                        newsContainer.append(newsHtml);
                    });

                    $('.post-item').hover(
                        function () {
                            $(this).css('transform', 'translateY(-5px)');
                            $(this).find('.post-grid-image').css('transform', 'scale(1.05)');
                        },
                        function () {
                            $(this).css('transform', 'translateY(0)');
                            $(this).find('.post-grid-image').css('transform', 'scale(1)');
                        }
                    );
                },
                error: function () {
                    $('#latest-news').html('<div class="col-12"><p class="text-center text-danger">Không thể tải tin tức.</p></div>');
                }
            });
        }

               // Tải bình luận và tin tức mới nhất khi trang đã sẵn sàng
             $(document).ready(function () {
            loadTestimonials(); // Tải lời chứng thực một cách động
            loadLatestNews(); // Tải tin tức mới nhất một cách động
        });
    </script>
}


