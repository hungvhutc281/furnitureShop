@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    /* Hiệu ứng hover cho sản phẩm */
    .product-item {
        transition: all 0.3s ease;
        border-radius: 8px;
        overflow: hidden;
        background: white;
    }

        .product-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        .product-item .image-holder {
            overflow: hidden;
            border-radius: 8px 8px 0 0;
        }

        .product-item .product-image {
            transition: transform 0.3s ease;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .product-item:hover .product-image {
            transform: scale(1.05);
        }

        .product-item .product-content {
            padding: 15px;
            background: white;
        }

        .product-item .element-title {
            margin-bottom: 8px;
            font-size: 1rem;
            font-weight: 600;
            color: #333;
            transition: color 0.3s ease;
        }

        .product-item:hover .element-title {
            color: #FFA500;
        }

    .wishlist-btn {
        transition: all 0.3s ease;
        opacity: 0.8;
        z-index: 10;
    }

        .wishlist-btn:hover {
            transform: scale(1.1);
            opacity: 1;
            background-color: #f8f9fa !important;
        }

    .product-item:hover .wishlist-btn {
        opacity: 1;
    }

    /* Responsive cho điện thoại */
    @@media (max-width: 768px) {
        .product-item .element-title {
            font-size: 0.9rem;
        }

        .product-item .product-content {
            padding: 10px;
        }

        .wishlist-btn {
            opacity: 1;
        }
    }

    /* Hiệu ứng loading trang web */
    .product-loading {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 200px;
    }

        .product-loading::after {
            content: "";
            width: 40px;
            height: 40px;
            border: 4px solid #f3f3f3;
            border-top: 4px solid #FFA500;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    /* --- css cho logo --- */
    .logo-bar .container-fluid {
        overflow: hidden;
        position: relative;
    }

    .logo-content {
        display: flex;
        align-items: center;
        animation: scroll-left 80s linear infinite; /* Điều chỉnh thời gian khi cần thiết */
    }

        .logo-content img {
            flex-shrink: 0; /* Ngăn hình ảnh thu nhỏ */
            width: 100px; /* Điều chỉnh chiều rộng logo khi cần */
            margin: 0 30px; /* Khoảng cách giữa các logo */
            opacity: 0.9; /* Làm mờ logo một chút */
            transition: opacity 0.3s ease; /* Chuyển đổi mượt mà khi di chuột qua */
        }

            .logo-content img:hover {
                opacity: 1; 
            }

    @@keyframes scroll-left {
        0% {
            transform: translateX(0%);
        }

        100% {
            transform: translateX(-100%); /* Cuộn sang trái 100% chiều rộng nội dung */
        }
    }

    .logo-content::after {
        content: attr(data-logos); /* Sử dụng thuộc tính dữ liệu để sao chép nội dung */
        display: flex;
        align-items: center;
    }

    h4.text-uppercase.text-center.mb-4 {
        font-weight: bold;
        color: orange;
        animation: blink 10s infinite;
    }

    /* Hiệu ứng nhấp nháy */
    @@keyframes blink {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0;
        }
    }

    /* --- Kiểu cho Hoạt ảnh Cuộn Lời chứng thực --- */
    .testimonial-scroll-container {
        tràn: ẩn; /* Ẩn lời chứng thực tràn */
        vị trí: tương đối;
    }

    .testimonial-content {
        hiển thị: flex;
        căn chỉnh các mục: trung tâm;
        /* Sử dụng hoạt ảnh */
        hoạt ảnh: cuộn sang trái 60 giây vô hạn tuyến tính; /* Điều chỉnh thời lượng khi cần */
    }

    .testimonial-item {
        flex-shrink: 0; /* Ngăn các mục thu nhỏ */
        chiều rộng: 300px; /* Điều chỉnh chiều rộng mục lời chứng thực khi cần */
        lề: 0 30px; /* Khoảng cách giữa các lời chứng thực */
        text-align: trung tâm;
    }

</style>
