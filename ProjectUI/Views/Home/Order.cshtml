@{
    ViewData["Title"] = "Đặt hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="mb-4">Sản phẩm trong đơn (1)</h5>
                    <div class="d-flex align-items-center mb-3">
                        <img src="/images/sample-product.jpg" alt="Sản phẩm" class="rounded me-3" style="width:70px;height:70px;object-fit:cover;">
                        <div>
                            <div class="fw-bold">Máy giặt cửa trước Aqua Inverter 10 kg AQD-DW1000J.BK</div>
                            <div class="text-muted small">Màu: Đen</div>
                        </div>
                        <div class="ms-auto text-end">
                            <div class="fw-bold text-danger fs-5">9.790.000 đ</div>
                            <div class="text-decoration-line-through text-muted small">16.990.000 đ</div>
                        </div>
                    </div>
                </div>
            </div>
            <form id="orderForm" novalidate>
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="mb-3">Người đặt hàng</h5>
                        <div class="mb-3">
                            <label class="form-label">Họ và tên</label>
                            <input type="text" class="form-control" id="fullname" required>
                            <div class="invalid-feedback">Vui lòng nhập tên</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Số điện thoại</label>
                            <input type="tel" class="form-control" id="phone" pattern="0[0-9]{9}" required>
                            <div class="invalid-feedback">Vui lòng nhập đúng định dạng số điện thoại</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email <span class="text-muted small">(Không bắt buộc)</span></label>
                            <input type="email" class="form-control" id="email">
                        </div>
                    </div>
                </div>
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="mb-3">Hình thức nhận hàng</h5>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="deliveryType" id="deliveryHome" value="home">
                            <label class="form-check-label" for="deliveryHome">Giao hàng tận nơi</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="deliveryType" id="deliveryStore" value="store" checked>
                            <label class="form-check-label" for="deliveryStore">Nhận tại cửa hàng</label>
                        </div>
                        <div class="mt-3" id="shopSelect">
                            <label class="form-label">Chọn shop có hàng gần nhất</label>
                            <select class="form-select" id="shop" required>
                                <option value="">-- Chọn shop --</option>
                                <option value="1">H&H Luxury - Hà Nội</option>
                                <option value="2">H&H Luxury - TP.HCM</option>
                            </select>
                            <div class="invalid-feedback">Vui lòng chọn thông tin nhận hàng tại shop</div>
                        </div>
                        <div class="mt-3">
                            <label class="form-label">Ghi chú yêu cầu</label>
                            <textarea class="form-control" id="note" rows="2" placeholder="Ghi chú (Ví dụ: Hãy gọi tôi khi chuẩn bị hàng xong)"></textarea>
                        </div>
                        <div class="form-check mt-3">
                            <input class="form-check-input" type="checkbox" id="support">
                            <label class="form-check-label" for="support">Yêu cầu hỗ trợ kỹ thuật</label>
                        </div>
                    </div>
                </div>
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="mb-3">Thông tin đơn hàng</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tổng tiền</span>
                            <span class="fw-bold">16.990.000 đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tổng khuyến mãi</span>
                            <span class="text-success">7.200.000 đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Phí vận chuyển</span>
                            <span class="text-success">Miễn phí</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Cần thanh toán</span>
                            <span class="fw-bold text-danger fs-5">9.790.000 đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Điểm thưởng</span>
                            <span class="text-warning fw-bold">+2,447</span>
                        </div>
                        <button type="submit" class="btn btn-danger w-100 mt-3" id="orderBtn" disabled>Đặt hàng</button>
                    </div>
                </div>
            </form>
            <div class="text-center text-muted small mt-3">
                Bằng việc tiến hành đặt mua hàng, bạn đồng ý với <a href="#" class="text-decoration-underline">Điều khoản dịch vụ</a> và <a href="#" class="text-decoration-underline">Chính sách xử lý dữ liệu cá nhân</a> của H&H Luxury.
            </div>
        </div>
    </div>
</section>
@section Scripts {
<script>
    // Validate form
    (function () {
        var form = document.getElementById('orderForm');
        var orderBtn = document.getElementById('orderBtn');
        form.addEventListener('input', function () {
            if (form.checkValidity()) {
                orderBtn.removeAttribute('disabled');
            } else {
                orderBtn.setAttribute('disabled', 'disabled');
            }
        });
        form.addEventListener('submit', function (e) {
            if (!form.checkValidity()) {
                e.preventDefault();
                e.stopPropagation();
            }
            form.classList.add('was-validated');
        });
    })();
</script>
} 