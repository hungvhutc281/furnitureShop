@{
    ViewData["Title"] = "Liên hệ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="contact-section py-5">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-7">
                <h2 class="mb-3" style="color:#e67e22;font-weight:bold;">Liên hệ để giải đáp thắc mắc - H&H Luxury</h2>
                <p style="font-size:1.1rem;">
                    H&H Luxury luôn sẵn sàng hợp tác và lắng nghe phản hồi từ quý khách hàng và đối tác. Vui lòng điền vào mẫu hoặc liên hệ trực tiếp với chúng tôi qua các kênh bên dưới.
                </p>
                <ul class="list-unstyled mt-4 mb-4">
                    <li><i class="bi bi-envelope-fill text-warning me-2"></i> <b>Email:</b> hungvhutc281@gmail.com</li>
                    <li><i class="bi bi-telephone-fill text-warning me-2"></i> <b>Đường dây nóng:</b> 0329362115</li>
                    <li><i class="bi bi-geo-alt-fill text-warning me-2"></i> <b>Địa chỉ:</b> Đường láng,Hà Nội</li>
                </ul>
                <div class="mt-4">
                    <b>Liên hệ với chúng tôi:</b>
                    <a href="https://www.facebook.com/" class="ms-2 me-2"><i class="bi bi-facebook fs-4 text-primary"></i></a>
                    <a href="https://www.facebook.com/" class="me-2"><i class="bi bi-instagram fs-4 text-danger"></i></a>
                    <a href="https://www.youtube.com/feed/you"><i class="bi bi-youtube fs-4 text-danger"></i></a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card shadow-sm p-4">
                    <h4 class="mb-3" style="color:#e67e22;">Gửi tin nhắn</h4>
                    <form id="contactForm" onsubmit="handleSubmit(event)">
                        <div class="mb-3">
                            <label for="name" class="form-label">Họ tên bạn</label>
                            <input type="text" class="form-control" id="name" placeholder="Nhập tên bạn" required>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" placeholder="Nhập email" required>
                        </div>
                        <div class="mb-3">
                            <label for="phone" class="form-label">Số điện thoại</label>
                            <input type="text" class="form-control" id="phone" placeholder="Nhập số điện thoại" required>
                        </div>
                        <div class="mb-3">
                            <label for="message" class="form-label">Nội dung tin nhắn</label>
                            <textarea class="form-control" id="message" rows="4" placeholder="Nhập nội dung cần phản hồi" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-warning w-100 fw-bold">Gửi yêu cầu</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap thông báo modal -->
    <div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="successModalLabel" style="color:#e67e22;">Gửi yêu cầu thành công</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Đã gửi email tới cửa hàng (hungvhutc281@gmail.com). Vui lòng đợi phản hồi qua email!
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-warning fw-bold" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
</section>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    function handleSubmit(event) {
        event.preventDefault(); // Ngăn chặn biểu mẫu gửi và làm mới trang
        const form = document.getElementById('contactForm');

        // Xác thực biểu mẫu 
        if (form.checkValidity()) {
            // Hiển thị 
            const successModal = new bootstrap.Modal(document.getElementById('successModal'));
            successModal.show();

            // Reset lại các trường
            form.reset();

            // Mô phỏng việc gửi email (trong trường hợp thực tế, đây sẽ là lệnh gọi API)
            setTimeout(() => {
                console.log('Email sent to hungvhutc281@gmail.com');
            }, 1000);
        } else {
            form.reportValidity(); // Hiển thị lỗi xác thực nếu có
    }
</script>