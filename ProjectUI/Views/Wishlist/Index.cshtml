@{
    ViewData["Title"] = "Danh sách yêu thích";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mt-4 mb-4">Sản phẩm đã lưu</h2>
<div id="wishlist-products" class="row flex-column"></div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
$(document).ready(function() {
    renderWishlist();

    function renderWishlist() {
        var wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');
        if (wishlist.length === 0) {
            $('#wishlist-products').html('<p>Bạn chưa lưu sản phẩm nào.</p>');
            updateWishlistCount();
            return;
        }
        $.get('https://localhost:7227/api/admin/product', function(products) {
            var filtered = products.filter(p => wishlist.includes(p.productId.toString()));
            if (filtered.length === 0) {
                $('#wishlist-products').html('<p>Bạn chưa lưu sản phẩm nào.</p>');
                updateWishlistCount();
                return;
            }
            let html = '';
            filtered.forEach(function(product) {
                html += `
                    <div class="col-12 mb-4">
                        <div class="card h-100 flex-row align-items-center p-3" style="min-height:160px;">
                            <a href="/Product/Details/${product.productId}" class="d-block" style="width:120px; min-width:120px;">
                                <img src="https://localhost:7227${product.image}" class="card-img-left me-4" alt="${product.productName}" style="width:120px; height:120px; object-fit:cover; border-radius:8px;">
                            </a>
                            <div class="flex-grow-1 ps-4" style="border-left:1px solid #eee;">
                                <a href="/Product/Details/${product.productId}" style="text-decoration:none;color:inherit;">
                                    <h5 class="card-title mb-2">${product.productName}</h5>
                                </a>
                                <p class="card-text text-danger fw-bold mb-2">${product.price.toLocaleString()} VNĐ</p>
                            </div>
                            <div class="d-flex flex-column gap-2 ms-3">
                                <button class="btn btn-danger btn-remove-wishlist" data-product-id="${product.productId}">Xóa</button>
                                <a href="/Product/Details/${product.productId}" class="btn btn-primary">Mua hàng</a>
                            </div>
                        </div>
                    </div>
                `;
            });
            $('#wishlist-products').html(html);
            updateWishlistCount();
        });
    }

    // Xử lý xóa sản phẩm khỏi wishlist
    $(document).on('click', '.btn-remove-wishlist', function() {
        var productId = $(this).data('product-id').toString();
        Swal.fire({
            title: 'H & H Luxury cho biết:',
            text: 'Bạn có chắc chắn muốn xóa sản phẩm này khỏi danh sách lưu?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Xóa',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) {
                var wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');
                wishlist = wishlist.filter(id => id !== productId);
                localStorage.setItem('wishlist', JSON.stringify(wishlist));
                renderWishlist();
            }
        });
        return;
    });

    // Hàm cập nhật số lượng wishlist trên navbar
    function updateWishlistCount() {
        var wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');
        $('#wishlist-count').text(wishlist.length);
    }
});
</script>

    <style>
        html, body {
            height: 100%;
        }

            body.min-vh-100 {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

        .container {
            flex: 1 0 auto;
        }

        footer {
            flex-shrink: 0;
        }
    </style>
} 