@{
    ViewData["Title"] = "Quản lý bình luận";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h1>Quản lý bình luận</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item active">Bình luận</li>
            </ol>
        </nav>
    </div>

    <section class="section">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Danh sách bình luận</h5>

                        <div class="mb-3">
                            <input id="searchBox" type="text" class="form-control" placeholder="Tìm kiếm bình luận theo nội dung hoặc người dùng..." />
                        </div>

                        <div class="mb-3">
                            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createCommentModal">
                                <i class="bi bi-plus-circle"></i> Thêm bình luận
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="commentsTable">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Người dùng</th>
                                        <th>Nội dung</th>
                                        <th>Đánh giá</th>
                                        <th>Ngày tạo</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<div class="modal fade" id="editCommentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chỉnh sửa bình luận</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editCommentForm">
                    <input type="hidden" id="editCommentId" />
                    <div class="mb-3">
                        <label for="editContent" class="form-label">Nội dung</label>
                        <textarea class="form-control" id="editContent" rows="3" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="editRating" class="form-label">Đánh giá</label>
                        <select class="form-select" id="editRating" required>
                            <option value="1">1 sao</option>
                            <option value="2">2 sao</option>
                            <option value="3">3 sao</option>
                            <option value="4">4 sao</option>
                            <option value="5">5 sao</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="saveEditComment">Lưu thay đổi</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal xác nhận xóa -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmDeleteLabel">Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa bình luận này không?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" id="btn-confirm-delete">Xóa</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createCommentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm bình luận mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createCommentForm">
                    <div class="mb-3">
                        <label for="createUserId" class="form-label">Chọn người dùng</label>
                        <select class="form-select" id="createUserId" required>
                            <option value="">-- Chọn người dùng --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="createContent" class="form-label">Nội dung</label>
                        <textarea class="form-control" id="createContent" rows="3" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="createRating" class="form-label">Đánh giá</label>
                        <select class="form-select" id="createRating" required>
                            <option value="1">1 sao</option>
                            <option value="2">2 sao</option>
                            <option value="3">3 sao</option>
                            <option value="4">4 sao</option>
                            <option value="5">5 sao</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-success" id="saveCreateComment">Lưu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
        const apiUrl = "https://localhost:7227/api/Comment"; // Đổi endpoint API tương ứng
        const usersApiUrl = "https://localhost:7227/api/auth"; // API endpoint for users

        function loadUsersForDropdown() {
            axios.get(usersApiUrl).then(res => {
                const userSelect = document.getElementById("createUserId");
                userSelect.innerHTML = '<option value="">-- Chọn người dùng --</option>'; // xóa lựa chọnnn
                res.data.forEach(user => {
                    const option = document.createElement("option");
                    option.value = user.userId;
                    option.textContent = user.fullName;
                    userSelect.appendChild(option);
                });
            }).catch(error => {
                console.error('Error loading users:', error);
                const userSelect = document.getElementById("createUserId");
                userSelect.innerHTML = '<option value="">-- Lỗi tải người dùng --</option>';
            });
        }

        // hiển thị danh sach người dùng cmt
        document.getElementById('createCommentModal').addEventListener('show.bs.modal', function () {
            loadUsersForDropdown();
        });

        function loadComments() {
            axios.get(apiUrl).then(res => {
                const rows = res.data.map(comment => `
                                    <tr>
                                        <td>${comment.commentId}</td>
                                        <td>${comment.userName}</td>
                                        <td>${comment.content}</td>
                                        <td>${'★'.repeat(comment.rating)}${'☆'.repeat(5 - comment.rating)}</td>
                                        <td>${new Date(comment.createdAt).toLocaleString('vi-VN')}</td>
                                        <td>
                                            <button class="btn btn-primary btn-sm edit-comment" data-id="${comment.commentId}">Sửa</button>
                                            <button class="btn btn-danger btn-sm delete-comment" data-id="${comment.commentId}">Xóa</button>
                                        </td>
                                    </tr>
                                `).join("");
                document.querySelector("#commentsTable tbody").innerHTML = rows;
            }).catch(error => {
                console.error('Error loading comments:', error);
                document.querySelector("#commentsTable tbody").innerHTML = '<tr><td colspan="6" class="text-center text-danger">Không thể tải bình luận!</td></tr>';
            });
        }

        // modal thêm , sửa , cập nhật
        document.addEventListener('click', function (e) {
            if (e.target.classList.contains('edit-comment')) {
                const id = e.target.dataset.id;
                axios.get(`${apiUrl}/${id}`).then(res => {
                    const comment = res.data;
                    document.getElementById("editCommentId").value = comment.commentId;
                    document.getElementById("editContent").value = comment.content;
                    document.getElementById("editRating").value = comment.rating;
                    new bootstrap.Modal(document.getElementById("editCommentModal")).show();
                });
            }
        });

        // lưu lại bình luận khách hàng
        document.getElementById("saveEditComment").addEventListener("click", function () {
            const id = document.getElementById("editCommentId").value;
            const data = {
                commentId: parseInt(id),
                content: document.getElementById("editContent").value,
                rating: parseInt(document.getElementById("editRating").value)
            };

            axios.put(`${apiUrl}/${id}`, data).then(() => {
                loadComments();
                bootstrap.Modal.getInstance(document.getElementById("editCommentModal")).hide();
                toastr.success('Cập nhật bình luận thành công!');
            }).catch(error => {
                console.error('Error updating comment:', error);
                toastr.error('Có lỗi xảy ra khi cập nhật bình luận!');
            });
        });

        // Xóa bình luận
        let deleteId = null;
        document.addEventListener('click', function (e) {
            if (e.target.classList.contains('delete-comment')) {
                deleteId = e.target.dataset.id;
                var modal = new bootstrap.Modal(document.getElementById('confirmDeleteModal'));
                modal.show();
            }
        });

        // Xác nhận bình luận
        document.getElementById('btn-confirm-delete').onclick = function () {
            if (deleteId !== null) {
                axios.delete(`${apiUrl}/${deleteId}`).then(() => {
                    loadComments();
                    deleteId = null;
                    bootstrap.Modal.getInstance(document.getElementById('confirmDeleteModal')).hide();
                    toastr.success('Xóa bình luận thành công!');
                }).catch(error => {
                    console.error('Error deleting comment:', error);
                    toastr.error('Có lỗi xảy ra khi xóa bình luận!');
                });
            }
        };

        // tìm kiếm
        document.getElementById("searchBox").addEventListener("input", function () {
            const keyword = this.value.toLowerCase();
            document.querySelectorAll("#commentsTable tbody tr").forEach(row => {
                const content = row.children[2].textContent.toLowerCase();
                const userName = row.children[1].textContent.toLowerCase();
                row.style.display = content.includes(keyword) || userName.includes(keyword) ? "" : "none";
            });
        });

        // tạo bình luận và lưu
        document.getElementById("saveCreateComment").addEventListener("click", function () {
            const userId = document.getElementById("createUserId").value;
            const content = document.getElementById("createContent").value;
            const rating = document.getElementById("createRating").value;

            if (!userId) {
                toastr.error('Vui lòng chọn người dùng!');
                return;
            }

            const data = {
                userId: parseInt(userId),
                content: content,
                rating: parseInt(rating)
            };

            axios.post(apiUrl, data).then(() => {
                loadComments();
                bootstrap.Modal.getInstance(document.getElementById("createCommentModal")).hide();
                toastr.success('Thêm bình luận thành công!');
                document.getElementById("createCommentForm").reset();
            }).catch(error => {
                console.error('Error creating comment:', error);
                toastr.error('Có lỗi xảy ra khi thêm bình luận!');
            });
        });

      
        loadComments();
    </script>
}