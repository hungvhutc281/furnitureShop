<!-- Modal xác nhận xóa -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmDeleteLabel">Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa tài khoản này không?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" id="btn-confirm-delete">Xóa</button>
            </div>
        </div>
    </div>
</div>


<!-- Modal thông báo xóa thành công -->
<div class="modal fade" id="deleteSuccessModal" tabindex="-1" aria-labelledby="deleteSuccessLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-success text-white">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteSuccessLabel">Thành công</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Tài khoản đã được xóa thành công và email đã được gửi cho người dùng.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
        // Fixed JavaScript code for user management
        const apiUrl = "https://localhost:7227/api/admin/user";

        function loadUsers() {
            axios.get(apiUrl).then(res => {
                const rows = res.data.map(user => {
                    let formattedDateBirth = '';
                    if (user.dateBirth) {
                        const date = new Date(user.dateBirth);
                        formattedDateBirth = `${date.getDate().toString().padStart(2, '0')}/${(date.getMonth() + 1).toString().padStart(2, '0')}/${date.getFullYear()}`;
                    }

                    let formattedCreatedAt = '';
                    if (user.createdAt) {
                        const date = new Date(user.createdAt);
                        formattedCreatedAt = `${date.getDate().toString().padStart(2, '0')}/${(date.getMonth() + 1).toString().padStart(2, '0')}/${date.getFullYear()}`;
                    }

                    return `
                        <tr>
                            <td>${user.fullName}</td>
                            <td>${user.email}</td>
                            <td>${user.phoneNumber || ''}</td>
                            <td>${user.address || ''}</td>
                            <td>${formattedDateBirth}</td>
                            <td>${user.gender === 0 ? 'Nam' : user.gender === 1 ? 'Nữ' : 'Riêng tư'}</td>
                            <td>${formattedCreatedAt}</td>
                            <td>
                                <button class="btn btn-danger btn-sm" onclick="deleteUser(${user.userId})">Xóa</button>
                            </td>
                        </tr>
                    `;
                }).join("");

                const tableBody = document.querySelector("#userTable tbody");
                if (tableBody) {
                    tableBody.innerHTML = rows;
                }
            }).catch(error => {
                console.error("Error loading users:", error);
                alert("Có lỗi xảy ra khi tải danh sách tài khoản.");
            });
        }

        //khởi tạo các biến
        let deleteId = null;

        // Chờ DOM được tải đầy đủ (DOM là cách mà trình duyệt đại diện cho trang web dưới dạng các đối tượng mà JavaScript )
        document.addEventListener('DOMContentLoaded', function () {
            loadUsers();

            // Chức năng tìm kiếm - kiểm tra xem phần tử có tồn tại không
            const searchBox = document.getElementById("searchBox");
            if (searchBox) {
                searchBox.addEventListener("input", function () {
                    const keyword = this.value.toLowerCase();
                    const tableRows = document.querySelectorAll("#userTable tbody tr");
                    tableRows.forEach(row => {
                        if (row.children.length >= 2) {
                            const fullName = row.children[0].textContent.toLowerCase();
                            const email = row.children[1].textContent.toLowerCase();
                            row.style.display = fullName.includes(keyword) || email.includes(keyword) ? "" : "none";
                        }
                    });
                });
            }

            // Gửi biểu mẫu người dùng - kiểm tra xem biểu mẫu có tồn tại không
            const userForm = document.getElementById("userForm");
            if (userForm) {
                userForm.addEventListener("submit", async function (e) {
                    e.preventDefault();
                    const id = document.getElementById("userId").value;
                    const userData = {
                        userId: id ? parseInt(id) : 0,
                        fullName: document.getElementById("fullName").value,
                        email: document.getElementById("email").value,
                        phoneNumber: document.getElementById("phoneNumber").value || null,
                        address: document.getElementById("address").value || null,
                        dateBirth: document.getElementById("dateBirth").value || null,
                        gender: document.getElementById("gender").value,
                        createdAt: id ? null : new Date().toISOString()
                    };

                    if (!userData.fullName || !userData.email) {
                        alert("Vui lòng nhập đầy đủ họ tên và email");
                        return;
                    }

                    try {
                        if (id) {
                            await axios.put(`${apiUrl}/${id}`, userData);
                        } else {
                            await axios.post(apiUrl, userData);
                        }
                        loadUsers();
                        const userModal = document.getElementById("userModal");
                        if (userModal) {
                            const modalInstance = bootstrap.Modal.getInstance(userModal);
                            if (modalInstance) {
                                modalInstance.hide();
                            }
                        }
                        userForm.reset();
                        const userIdField = document.getElementById("userId");
                        if (userIdField) {
                            userIdField.value = "";
                        }
                    } catch (error) {
                        console.error("Error:", error);
                        alert("Có lỗi xảy ra khi lưu tài khoản. Vui lòng thử lại.");
                    }
                });
            }

            // xác nhận xóa
            const confirmDeleteBtn = document.getElementById('btn-confirm-delete');
            if (confirmDeleteBtn) {
                confirmDeleteBtn.addEventListener('click', function () {
                    if (deleteId !== null) {
                        axios.delete(`${apiUrl}/${deleteId}`).then(() => {
                            loadUsers();
                            deleteId = null;

                            const confirmModal = document.getElementById('confirmDeleteModal');
                            if (confirmModal) {
                                const modalInstance = bootstrap.Modal.getInstance(confirmModal);
                                if (modalInstance) {
                                    modalInstance.hide();
                                }
                            }

                            // hiển thị modal thành công
                            const successModal = document.getElementById('deleteSuccessModal');
                            if (successModal) {
                                const successModalInstance = new bootstrap.Modal(successModal);
                                successModalInstance.show();
                            }
                        }).catch(error => {
                            console.error("Error:", error);
                            alert("Có lỗi xảy ra khi xóa tài khoản.");
                        });
                    }
                });
            }
        });

        // hàm xóa người dùng
        function deleteUser(id) {
            if (id <= 0) {
                alert("ID không hợp lệ, vui lòng thử lại.");
                return;
            }
            deleteId = id;
            const confirmModal = document.getElementById('confirmDeleteModal');
            if (confirmModal) {
                const modal = new bootstrap.Modal(confirmModal);
                modal.show();
            }
        }

        // làm cho hàm toàn cục dự án
        window.deleteUser = deleteUser;
    </script>
}
