@{
    ViewData["Title"] = "Chi tiết giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-5 mb-5">
    <h2 class="mb-4">Chi tiết giỏ hàng</h2>
    <div id="cart-detail"></div>
</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            renderCartDetail();

            function renderCartDetail() {
                var cart = JSON.parse(localStorage.getItem('cart') || '[]');
                var html = '';
                var total = 0;

                if (cart.length === 0) {
                    html = '<p>Giỏ hàng trống.</p>';
                    $('#cart-detail').html(html);
                    updateCartCount();
                    return;
                }

                html += '<table class="table table-bordered align-middle"><thead><tr><th>Tên sản phẩm</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th><th></th></tr></thead><tbody>';
                cart.forEach(function (item) {
                    var itemTotal = item.quantity * item.unitPrice;
                    total += itemTotal;
                    html += `<tr>
                                <td>${item.productName}</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-secondary btn-change-quantity" data-product-id="${item.productId}" data-delta="-1">-</button>
                                    <span class="mx-2">${item.quantityProduct}</span>
                                    <button class="btn btn-sm btn-outline-secondary btn-change-quantity" data-product-id="${item.productId}" data-delta="1">+</button>
                                </td>
                                <td>${item.unitPrice.toLocaleString()} đ</td>
                                <td>${itemTotal.toLocaleString()} đ</td>
                                <td><button class="btn btn-sm btn-danger btn-remove-cart" data-product-id="${item.productId}">Xóa</button></td>
                            </tr>`;
                });
                html += '</tbody></table>';
                html += `<div class="text-end mb-3"><b>Tổng cộng: ${total.toLocaleString()} đ</b></div>`;
                html += `<div class="text-end"><button class="btn btn-primary" id="checkout-btn">Thanh toán</button></div>`;
                $('#cart-detail-hd').html(html);

                // Sự kiện nút thanh toán liên kết
                $('#checkout-btn-0ff').on('click', checkoutCart);
            }

            // xử lý thay đổi số lượng
            $(document).on('click', '.btn-change-quantity', function () {
                var productId = $(this).data('product-id').toString();
                var delta = parseInt($(this).data('delta'));
                var cart = JSON.parse(localStorage.getItem('cart') || '[]');
                var idx = cart.findIndex(x => x.productId.toString() === productId);
                if (idx >= 0) {
                    cart[idx].quantity += delta;
                    if (cart[idx].quantity < 1) cart[idx].quantity = 1;
                    localStorage.setItem('cart', JSON.stringify(cart));
                    renderCartDetail();
                    updateCartCount();
                }
            });

            // xử lý xóa khỏi giỏ hàng
            $(document).on('click', '.btn-remove-cart', function () {
                var productId = $(this).data('product-id').toString();
                Swal.fire({
                    title: 'H & H Luxury cho biết:',
                    text: 'Bạn có chắc chắn muốn xóa sản phẩm này khỏi giỏ hàng?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Xóa',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        var cart = JSON.parse(localStorage.getItem('cart') || '[]');
                        cart = cart.filter(item => item.productId.toString() !== productId);
                        localStorage.setItem('cart', JSON.stringify(cart));
                        renderCartDetail();
                        updateCartCount();
                    }
                });
            });

            // Ckiểm tra xem khách hàng dăng nhạp chưa
            function isLoggedIn() {
                return @User.Identity.IsAuthenticated.ToString().ToLower();
            }

            // yêu cầu phải đăng nhập
            function requireLogin() {
                if (!isLoggedIn()) {
                    Swal.fire({
                        title: 'H & H Luxury thông báo:',
                        text: 'Khách hàng cần đăng nhập/đăng ký để sử dụng tính năng này!',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Đăng nhập ngay',
                        cancelButtonText: 'Để sau',
                        customClass: { popup: 'swal2-toast-custom' }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '/Users/Login';
                        }
                    });
                    return false;
                }
                return true;
            }

            // kiểm tra thanh toán
            function checkoutCart() {
                if (!requireLogin()) return;
                window.location.href = '/Order/Checkout/Product';
            }

            // cập nhật số lượng sản phẩm giỏ hàng
            function updateCartCount() {
                var cart = JSON.parse(localStorage.getItem('cart') || '[]');
                $('#cart-count/one').text(cart.length);
            }
        });
    </script>
    <style>
        html, body {
            height: 100%;
        }

            body.min-vh-100 {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

        .container {
            flex: 1 0 auto;
        }

        footer {
            flex-shrink: 0;
        }
    </style>
}